# 复制成 .env 再改（.env 已被 .gitignore 忽略，不会提交）：
#
#   cp .env.example .env
#   # 改 APP_ADMIN_KEY（必填），其它按需
#   docker compose up -d
#
# 生成一个随机密钥：
#   openssl rand -base64 24 | tr '+/' '-_' | tr -d '='

# 后台登录密钥。必填，没有它后端起不来（不会退回默认密钥）。
APP_ADMIN_KEY=在这里填你自己生成的密钥

# 宿主机映射的端口（容器里固定 8080）
APP_PORT=8080

# 演示模式：true = 后台只读，所有写操作被服务端拒绝（403）。
# 想把站挂出去给别人随便点，就设 true
APP_DEMO_MODE=false

# 演示模式下显示在登录页上的密钥提示（留空则不显示）。
# 演示站的密钥本来就是公开的，写出来省得别人猜；自己正式用的站留空
APP_DEMO_KEY_HINT=

# 时区（影响访问统计按天/按小时的分组）
TZ=Asia/Shanghai
