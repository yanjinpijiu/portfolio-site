# /opt/portfolio/portfolio.env   —— 权限必须是 600，属主是运行后端的用户
#
# 后端启动时会读这个文件。没有 APP_ADMIN_KEY 会直接启动失败，不会退回默认密钥。
#
# 生成一个随机密钥：
#   openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
#
# 忘了密钥是多少：cat /opt/portfolio/portfolio.env

APP_ADMIN_KEY=在这里填你自己生成的密钥

# 后端监听端口。别用 8080-8082 —— 这台服务器上 RocketMQ 的 broker 容器
# 一次性映射了这三个端口。改了这里，nginx 配置里的 proxy_pass 也要一起改。
SERVER_PORT=8090

# local = 存在服务器磁盘 /opt/portfolio/data/files；oss = 存阿里云对象存储
APP_STORAGE_TYPE=local

# 用 OSS 的话把上面改成 oss，并取消下面四行注释（RAM 子账号只需
# oss:PutObject / oss:GetObject / oss:DeleteObject 三个权限）
#OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
#OSS_BUCKET=
#OSS_ACCESS_KEY_ID=
#OSS_ACCESS_KEY_SECRET=
#OSS_PUBLIC_PREFIX=
